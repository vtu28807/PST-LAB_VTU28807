import java.io.BufferedReader;
import java.io.InputStreamReader;
import java.io.IOException;

public class Solution {

    public static long calculateStringSimilarity(String s) {
        int n = s.length();
        int[] z = new int[n];
        
        // Z[0] is the length of the whole string matching itself
        z[0] = n;
        long totalSimilarity = n;
        
        // Window [l, r] that matches a prefix of s
        int l = 0, r = 0;
        for (int i = 1; i < n; i++) {
            if (i <= r) {
                z[i] = Math.min(r - i + 1, z[i - l]);
            }
            while (i + z[i] < n && s.charAt(z[i]) == s.charAt(i + z[i])) {
                z[i]++;
            }
            if (i + z[i] - 1 > r) {
                l = i;
                r = i + z[i] - 1;
            }
            totalSimilarity += z[i];
        }
        
        return totalSimilarity;
    }

    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        String line = br.readLine();
        if (line == null || line.trim().isEmpty()) return;
        
        int t = Integer.parseInt(line.trim());
        StringBuilder sb = new StringBuilder();
        
        while (t-- > 0) {
            String s = br.readLine().trim();
            sb.append(calculateStringSimilarity(s)).append("\n");
        }
        
        System.out.print(sb.toString());
    }
}
