import java.io.*;
import java.util.*;
import java.text.*;
import java.math.*;
import java.util.regex.*;

interface PerformOperation {
    String calculate(int num);
}

public class Solution {

    public static void main(String[] args) {
        int num;
        int val;
        Scanner scan = new Scanner(System.in);
        int T = scan.nextInt();

        while (T > 0) {
            val = scan.nextInt();
            num = scan.nextInt();

            switch (val) {
                case 1:
                    System.out.println(isOdd().calculate(num));
                    break;
                case 2:
                    System.out.println(isPrime().calculate(num));
                    break;
                case 3:
                    System.out.println(isPalindrome().calculate(num));
                    break;
            }

            T--;
        }
        scan.close();
    }

    static PerformOperation isOdd(){
        return new PerformOperation() {
            public String calculate(int n) {
                return (n % 2 != 0) ? "ODD" : "EVEN";
            }
        };
    }

    static PerformOperation isPrime(){
        return new PerformOperation() {
            public String calculate(int n) {
                if (n < 2) {
                    return "COMPOSITE";
                }
                for (int i = 2; i <= Math.sqrt(n); i++) {
                    if (n % i == 0) {
                        return "COMPOSITE";
                    }
                }
                return "PRIME";
            }
        };
    }

    static PerformOperation isPalindrome(){
        return new PerformOperation() {
            public String calculate(int n) {
                int original = n;
                int reversed = 0;
                while (n != 0) {
                    int digit = n % 10;
                    reversed = reversed * 10 + digit;
                    n /= 10;
                }
                return (original == reversed) ? "PALINDROME" : "NOT PALINDROME";
            }
        };
    }
}
